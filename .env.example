# Copy to .env and adjust. All variables are optional; defaults are shown.

# Where your Markdown/PDF documents live. Point this at a synced folder
# (Dropbox/OneDrive/Syncthing) or a separately cloned private repo to share
# documents across machines without committing them here.
#RAG_DOCS_DIR=./data/docs

# Machine-local index (never synced; rebuild with `rag-mcp ingest`).
#RAG_INDEX_DIR=./data/index

# Embeddings: ollama (default, local), openai (any OpenAI-compatible API) or hash (tests only).
#RAG_EMBED_PROVIDER=ollama
#RAG_EMBED_MODEL=nomic-embed-text
#RAG_OLLAMA_URL=http://localhost:11434
#RAG_OPENAI_BASE_URL=https://api.openai.com/v1
#RAG_OPENAI_API_KEY=

# Vector store: leave empty for embedded Qdrant (no server). With Docker Desktop:
#   docker compose up -d
#RAG_QDRANT_URL=http://localhost:6333

# Multi-project layout (see README "Несколько проектов"). Shared folders searched with every project:
#RAG_SHARED_PROJECTS=["common"]
# Force a project instead of detecting it from the workspace:
#RAG_PROJECT=

# Watch mode: the MCP server re-indexes when files change (see README "Автоматическая переиндексация").
#RAG_WATCH=true
#RAG_WATCH_DEBOUNCE_MS=1500

# Chunking and retrieval
#RAG_CHUNK_SIZE=1800
#RAG_CHUNK_OVERLAP=200
#RAG_TOP_K=6
