# rag-mcp settings. install.sh / install.ps1 copy this file to .env on first run.
# Every line is optional: commented values are the defaults. Prefix RAG_.
# Relative paths are relative to the rag-mcp folder.

# --- Documents -----------------------------------------------------------
# Folder with your Markdown/PDF. Can be a synced folder (Dropbox, iCloud,
# Syncthing) or a cloned private repo. Subfolders = projects, common/ = shared.
# RAG_DOCS_DIR=data/docs
# Other folders can be connected in place, without copying:
#   uv run rag-mcp add /path/to/notes --name notes
# Machine-local index (never commit; rebuilt with `uv run rag-mcp ingest`).
# RAG_INDEX_DIR=data/index

# --- Embeddings ----------------------------------------------------------
# ollama (local, default) | openai (any OpenAI-compatible API) | hash (tests only)
# RAG_EMBED_PROVIDER=ollama
# bge-m3: multilingual, best on Russian notes (~1.2 GB, `ollama pull bge-m3`).
# Lighter alternative: nomic-embed-text (worse on Russian).
# After changing the model: `uv run rag-mcp ingest --rebuild`.
RAG_EMBED_MODEL=bge-m3
# RAG_OLLAMA_URL=http://localhost:11434
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_API_KEY=
# RAG_EMBED_BATCH_SIZE=32

# --- Projects ------------------------------------------------------------
# Folders of RAG_DOCS_DIR searched together with the current project.
# RAG_SHARED_PROJECTS=["common"]
# Force one project instead of detecting it from the workspace folder.
# RAG_PROJECT=

# --- Chunking and retrieval ----------------------------------------------
# RAG_CHUNK_SIZE=1800
# RAG_CHUNK_OVERLAP=200
# RAG_TOP_K=6
# RAG_CANDIDATE_MULTIPLIER=4
# RAG_RRF_K=60

# --- Vector store --------------------------------------------------------
# Empty = files in RAG_INDEX_DIR. Qdrant only for very large corpora:
# `docker compose up -d`, then
# RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=
# RAG_COLLECTION=docs
